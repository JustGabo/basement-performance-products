# Supabase project settings (Dashboard > Connect)
# Safe to expose in the browser. Access is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix this variable with NEXT_PUBLIC_ or commit its value.
# Create it in Dashboard > Settings > API Keys only when admin/server jobs need it.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Shopify owns products, market-specific prices, inventory and checkout.
COMMERCE_PROVIDER=shopify

# Set COMMERCE_PROVIDER=shopify after validating the Headless storefront.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=public-storefront-token
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=private-storefront-token
SHOPIFY_API_VERSION=2026-07
# Optional hosted Shopify customer-account URL. Leave empty until customer
# accounts are enabled and the Headless channel displays the account URL.
SHOPIFY_CUSTOMER_ACCOUNT_URL=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace_with_customer_account_client_id
# Server-only. Never prefix with NEXT_PUBLIC_.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=replace_with_customer_account_client_secret
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=http://localhost:3000/account/authorize
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URL=http://localhost:3000/
# Generate with: openssl rand -base64 48
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=replace_with_at_least_32_random_characters

# Storefront market defaults. Dominican prices remain USD in Shopify and are
# presented approximately in DOP before the final USD checkout charge.
DEFAULT_MARKET_COUNTRY=US
NEXT_PUBLIC_DOP_PER_USD=60

# PayPal Checkout. Use sandbox while developing, then replace both credentials for live mode.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_ENV=sandbox
